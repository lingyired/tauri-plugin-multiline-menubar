{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "popup"],
  "permissions": [
    "core:default",
    "opener:default",
    "multiline-menubar:default",
    "multiline-menubar:allow-remove",
    "multiline-menubar:allow-set-menu",
    "multiline-menubar:allow-remove-menu",
    "multiline-menubar:allow-set-popup-window",
    "multiline-menubar:allow-open-popup",
    "multiline-menubar:allow-close-popup",
    "multiline-menubar:allow-toggle-popup"
  ]
}
